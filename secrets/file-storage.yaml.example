# file-storage operator secret configuration (EXAMPLE).
# Copy to secrets/file-storage.yaml (git-ignored) and fill in REAL values:
#
#   openssl rand -hex 32                    # auth.jwt_secret
#   openssl rand -hex 24                    # replication.api_key
#   file-storage hash-password              # per user (argon2id, reads stdin)
#
# C-01: a container booted with this EXAMPLE (or any shipped literal)
# exits non-zero by design.

server:
  host: "0.0.0.0"
  port: 8080
  grpc_port: 9090
  grpc_tls:
    enabled: false
    cert_path: "/etc/file-storage/tls/server.crt"
    key_path: "/etc/file-storage/tls/server.key"
    client_ca_path: null

storage:
  root: "/var/lib/file-storage/data/blocks"
  temp_dir: "/var/lib/file-storage/data/tmp"
  shard_depth: 2

database:
  path: "/var/lib/file-storage/data/index.redb"

chunking:
  min: 8192
  avg: 32768
  max: 131072

compression:
  level: 3
  min_size: 1024

cache:
  l1_max_bytes: 268435456
  l1_ttl_secs: 300
  l2_max_bytes: 536870912
  l2_ttl_secs: 3600
  manifest_capacity: 10000
  manifest_ttl_secs: 60

auth:
  jwt_secret: "PASTE_openssl_rand_hex_32_HERE"
  access_ttl_secs: 900
  refresh_ttl_secs: 604800
  users:
    - username: admin
      password_hash: "PASTE_FILE_STORAGE_HASH_PASSWORD_OUTPUT_HERE"
      tenant_id: "01930000-0000-7000-8000-000000000001"
      role: admin

encryption:
  enabled: false
  keys_dir: "/var/lib/file-storage/data/keys"

rate_limit:
  enabled: true
  per_second: 500
  burst: 1000

replication:
  enabled: false
  mode: async
  target_url: null
  upstream_url: null
  api_key: "PASTE_openssl_rand_hex_24_HERE"
  queue_capacity: 10000
  batch_size: 64
  flush_interval_ms: 5000
  sync_timeout_ms: 5000

retention:
  gc_mode: refcount
  grace_period_secs: 86400
  gc_interval_secs: 300
  orphan_min_age_secs: 3600

limits:
  max_file_size: 10737418240
  max_body: 1073741824

logging:
  format: json
  level: info

tenants:
  - id: "01930000-0000-7000-8000-000000000001"
    name: "default"
